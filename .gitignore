# Environments are created per machine, never copied.  A venv hard-codes the
# absolute path of the interpreter that built it, so shipping one between
# laptops (or into Kaggle) produces an environment that silently half-works.
.venv/
venv/
env/

# Run artefacts.  These are reproducible from (config_hash, seed) and get large
# fast; handing a folder to a teammate should not mean handing over gigabytes.
# Export deliberately when a specific run needs to travel.
runs/

# Phase-3 step 6 and step 10 write here by default: the calibration record, the
# Gate-2 report, and one model checkpoint per (arm, seed) -- 27 of them.  None
# of it is versioned, and the calibration record in particular does not need to
# be: the plan requires `N` and the frozen beta to be **transcribed into
# GRAFT_PHASE3_BUILD.md section 6**, so the decision travels in the document and
# the JSON is only its evidence.  Export deliberately if a specific run has to
# travel.
artefacts/

# The paper library and its backup zip are large binaries that are already
# reproducible via Research papers/download_papers.ps1.  The index (INDEX.md,
# papers.csv, README.md) and the download script stay tracked; the ~192 MB of
# PDFs do not, so cloning or handing over the repo stays fast.  Run the script
# once per machine to refill the folder.
*.zip
Research papers/**/*.pdf

# Dated snapshot backups of the whole project.  Git already provides history;
# these are the user's own copies and are not tracked.
GRAFT-[0-9]*/

# Scratch from PDF-text extraction runs (vendored wheels, extracted paper text).
# Not project source; regenerable; ~112 MB.
.tmp_pdf_deps/
.tmp_pdf_text/
tmp/

# Phase 2.5's raw corpus download (LongMemEval-S, ~278 MB). Refetched per
# machine from HF `xiaowu0162/longmemeval`; the pin lives in
# scripts/phase2_5/common.py (CORPUS_SHA256) and provenance.json. The derived
# sample, items, labels and guidelines under data/phase2_5/ stay tracked —
# they are Gate-0 deliverables Phase 6 consumes.
data/phase2_5/raw/

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

.vscode/
.idea/
.DS_Store
Thumbs.db

# Phase 6 external datasets: pinned by SHA, licences recorded, re-fetched per
# machine. DialogRE is non-commercial research use only, so it must not be
# redistributed through this repo.
data/phase6/raw/

# Phase 8's external dataset: MuSiQue-Full (CC BY 4.0), SHA-pinned in
# graphbuild.pins.DATASETS and re-fetched per machine. ~590 MB extracted,
# plus the 272 MB official archive kept under data/musique/ so Phase 9's
# MuSiQue-Ans splits can be extracted without a second download.
data/phase8/raw/
data/musique/

# Working backups (e.g. a label file snapshotted before an edit).
*.bak
*.bak[0-9]

data/phase9/raw/
